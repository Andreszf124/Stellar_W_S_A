# stellar/soroban/Rust output
target
.soroban

# project identity and alias files will be in .config/stellar
.config

# test snapshot folders from sample contracts
test_snapshots

# build output
dist
dist-ssr

# dependencies
node_modules/

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# environment variables
.env
.env.*
!.env.example
!.env.production

# easy way to create temporary local-only files and folders
*.local.*

# macOS-specific files
.DS_Store

# generated contract bindings + clients (Binding packages and flattened index.ts)
app-lib/clients/*
!app-lib/clients/.gitkeep
# The deployed contracts' clients are versioned so a fresh clone (or Vercel) builds
# without redeploying. Scaffold regenerates them with the same content.
!app-lib/clients/index.ts
!app-lib/clients/closet/
!app-lib/clients/closet/dist/
!app-lib/clients/reputation/
!app-lib/clients/reputation/dist/

# Agent harness local-only state (skills and shared config ARE committed)
.claude/settings.local.json
.claude/worktrees/

# TypeScript incremental build info
*.tsbuildinfo

# Seed output (claim codes are secrets)
scripts/out/
